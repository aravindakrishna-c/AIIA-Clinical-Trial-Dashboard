# ==============================================================================
# AIIA Clinical Trials Dashboard - Production / Deployment Configuration
# Ministry of Ayush / All India Institute of Ayurveda (AIIA)
# ==============================================================================

# Database Connection
# Production (PostgreSQL):
DATABASE_URL=postgresql://aiia_ctms_user:secure_password_here@localhost:5432/aiia_ctms_db
# Local SQLite fallback for quick testing / development:
# DATABASE_URL=sqlite:///./aiia_ctms.db

# Security & Authentication (21 CFR Part 11 / GCP align)
# CRITICAL: Change in production to a cryptographically secure 64-char hex string
JWT_SECRET=aiia_super_secret_ctms_development_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Environment & Logging
ENVIRONMENT=production
PROJECT_NAME="AIIA Clinical Trials Management System"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aiia-ctms.ayush.gov.in
